# ---------- Server ----------
PORT=8090
APP_URL=http://localhost:8090
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- MongoDB ----------
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=friday

# ---------- Auth ----------
ALLOW_REGISTRATION=true
SEED_DEMO=true
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Optional: serve the SPA from disk instead of the embedded build
# FRONTEND_DIST=../frontend/dist

# ---------- AI / BYOK ----------
# Generate with: openssl rand -base64 32
# Required in production to encrypt user-provided provider API keys.
APP_ENCRYPTION_KEY=
# Allow private/loopback AI endpoints (needed for local Ollama / mock servers)
AI_ALLOW_PRIVATE_ENDPOINTS=false

# ---------- Email (optional) ----------
# Local development: leave SMTP_HOST empty; invitation/reset links are logged to stderr.
# Production: use SMTP (587 STARTTLS) or SES/Resend SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Friday <no-reply@friday.local>
SMTP_FROM_NAME=Friday
SMTP_TLS=true
SMTP_IMPLICIT_TLS=false

# ---------- OIDC (optional) ----------
# Works with Keycloak, Authentik, Auth0, Okta, Google, GitLab, etc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8090/api/auth/oidc/callback
OIDC_NAME=Single sign-on
